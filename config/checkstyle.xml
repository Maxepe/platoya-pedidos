<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- Reglas alineadas con el checklist de code review del TPI (seccion Etapa 7). -->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>

    <module name="TreeWalker">

        <!-- Item 2: funciones cortas -->
        <module name="MethodLength">
            <property name="max" value="15"/>
            <property name="countEmpty" value="false"/>
        </module>

        <!-- Item 3: complejidad ciclomatica por metodo -->
        <module name="CyclomaticComplexity">
            <property name="max" value="5"/>
        </module>

        <!-- Item 4: pocos parametros -->
        <module name="ParameterNumber">
            <property name="max" value="4"/>
            <property name="tokens" value="METHOD_DEF"/>
        </module>

        <!-- Item 7: sin catch generico -->
        <module name="IllegalCatch"/>

        <!-- Item 9: nombres expresivos (minimo 3 caracteres) -->
        <module name="LocalVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]{2,}$"/>
        </module>

        <!-- Item 10: sin numeros magicos -->
        <module name="MagicNumber"/>

        <!-- Item 5: inyeccion por constructor, sin new de infraestructura -->
        <module name="RegexpSinglelineJava">
            <property name="id" value="fieldInjection"/>
            <property name="format" value="^\s*@Autowired\s*$"/>
            <property name="message" value="Inyeccion por campo: usar inyeccion por constructor."/>
            <property name="ignoreComments" value="true"/>
        </module>
        <module name="RegexpSinglelineJava">
            <property name="id" value="concreteNotifier"/>
            <property name="format" value="new\s+(EmailSender|WhatsAppService)\s*\("/>
            <property name="message" value="Dependencia concreta de notificacion: inyectar la abstraccion (DIP)."/>
            <property name="ignoreComments" value="true"/>
        </module>
    </module>
</module>
